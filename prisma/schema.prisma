generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COORDINATOR
  HOD
  FACULTY
  STUDENT
}

model Department {
  id       String @id @default(cuid())
  name     String
  timezone String @default("Asia/Kolkata")
  onlineTeachingEnabled Boolean @default(false)
  users    User[]
  semesters Semester[]
  holidays Holiday[]
  faculty Faculty[]
  availability FacultyAvailability[]
  courses Course[]
  qualifications FacultyQualification[]
  sections Section[]
  memberships SectionMembership[]
  rooms Room[]
  slots TimeSlot[]
  allocations CourseAllocation[]
  masterReceipts MasterMutationReceipt[]
  timetableVersions TimetableVersion[]
  timetableEntries TimetableEntry[]
  obligations TeachingObligation[]
  occurrences ClassOccurrence[]
  reservations ResourceReservation[]
  scheduleReceipts MutationReceipt[]
  auditEvents AuditEvent[]
  leaveRequests LeaveRequest[]
  notifications Notification[]

}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
  active       Boolean @default(true)
  role         Role
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  faculty Faculty?
  memberships SectionMembership[]
  notifications Notification[]
  reviewedLeave LeaveRequest[] @relation("LeaveReviewer")
  @@unique([id, departmentId])
  @@index([departmentId])
}

enum TeachingType {
  THEORY
  LAB
}

model Semester {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  code String
  name String
  startDate String @db.VarChar(10)
  endDate String @db.VarChar(10)
  active Boolean @default(false)
  scheduleRevision Int @default(0)
  holidays Holiday[]
  sections Section[]
  allocations CourseAllocation[]
  timetableVersions TimetableVersion[]
  leaveRequests LeaveRequest[]
  @@unique([departmentId, code])
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

model Holiday {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  semesterId String
  semester Semester @relation(fields: [semesterId, departmentId], references: [id, departmentId], onDelete: Restrict)
  date String @db.VarChar(10)
  name String
  @@unique([departmentId, semesterId, date])
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

model Faculty {
  leaveRequests LeaveRequest[]
  occurrences ClassOccurrence[]
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  userId String @unique
  user User @relation(fields: [userId, departmentId], references: [id, departmentId], onDelete: Restrict)
  @@unique([userId, departmentId])
  designation String
  targetMinutesPerWeek Int
  maxMinutesPerDay Int
  maxMinutesPerWeek Int
  availability FacultyAvailability[]
  qualifications FacultyQualification[]
  allocations CourseAllocation[]
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

model FacultyAvailability {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  facultyId String
  faculty Faculty @relation(fields: [facultyId, departmentId], references: [id, departmentId], onDelete: Restrict)
  weekday Int
  startMinute Int
  endMinute Int
  @@unique([departmentId, facultyId, weekday, startMinute, endMinute])
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

model Course {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  code String
  name String
  type TeachingType
  requiredContactMinutes Int
  qualifications FacultyQualification[]
  allocations CourseAllocation[]
  @@unique([departmentId, code])
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

model FacultyQualification {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  facultyId String
  faculty Faculty @relation(fields: [facultyId, departmentId], references: [id, departmentId], onDelete: Restrict)
  courseId String
  course Course @relation(fields: [courseId, departmentId], references: [id, departmentId], onDelete: Restrict)
  @@unique([departmentId, facultyId, courseId])
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

model Section {
  occurrences ClassOccurrence[]
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  semesterId String
  semester Semester @relation(fields: [semesterId, departmentId], references: [id, departmentId], onDelete: Restrict)
  code String
  name String
  strength Int
  preferredPeriodsPerDay Int
  memberships SectionMembership[]
  allocations CourseAllocation[]
  @@unique([departmentId, semesterId, code])
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

model SectionMembership {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  sectionId String
  section Section @relation(fields: [sectionId, departmentId], references: [id, departmentId], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId, departmentId], references: [id, departmentId], onDelete: Restrict)
  isRepresentative Boolean @default(false)
  @@unique([departmentId, sectionId, userId])
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

model Room {
  entries TimetableEntry[]
  occurrences ClassOccurrence[]
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  code String
  name String
  type TeachingType
  capacity Int
  @@unique([departmentId, code])
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

model TimeSlot {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  label String
  weekday Int
  startMinute Int
  endMinute Int
  @@unique([departmentId, weekday, startMinute, endMinute])
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

model CourseAllocation {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  archived Boolean @default(false)
  version Int @default(1)
  courseId String
  course Course @relation(fields: [courseId, departmentId], references: [id, departmentId], onDelete: Restrict)
  facultyId String
  faculty Faculty @relation(fields: [facultyId, departmentId], references: [id, departmentId], onDelete: Restrict)
  sectionId String
  section Section @relation(fields: [sectionId, departmentId], references: [id, departmentId], onDelete: Restrict)
  semesterId String
  semester Semester @relation(fields: [semesterId, departmentId], references: [id, departmentId], onDelete: Restrict)
  weeklyPeriods Int
  requiredContactMinutes Int
  entries TimetableEntry[]
  obligations TeachingObligation[]
  @@unique([departmentId, semesterId, sectionId, courseId])
  @@unique([id, departmentId])
  @@index([departmentId, archived])
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
}
enum SchedulingStatus {
  ACTIVE
  CANCELLED
}
enum DeliveryStatus {
  PENDING
  HELD
  NOT_HELD
}
enum ResourceType {
  FACULTY
  SECTION
  ROOM
}
model TimetableVersion {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  semesterId String
  semester Semester @relation(fields: [semesterId, departmentId], references: [id, departmentId], onDelete: Restrict)
  status TimetableStatus @default(DRAFT)
  version Int @default(1)
  baseScheduleRevision Int
  effectiveFrom String @db.VarChar(10)
  effectiveTo String @db.VarChar(10)
  publishedAt DateTime? @db.Timestamptz(3)
  entries TimetableEntry[]
  @@unique([id, departmentId])
  @@index([departmentId, semesterId, status])
}
model TimetableEntry {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  timetableVersionId String
  timetableVersion TimetableVersion @relation(fields: [timetableVersionId, departmentId], references: [id, departmentId], onDelete: Restrict)
  seriesId String
  allocationId String
  allocation CourseAllocation @relation(fields: [allocationId, departmentId], references: [id, departmentId], onDelete: Restrict)
  roomId String
  room Room @relation(fields: [roomId, departmentId], references: [id, departmentId], onDelete: Restrict)
  weekday Int
  startMinute Int
  endMinute Int
  occurrences ClassOccurrence[]
  @@unique([timetableVersionId, seriesId])
  @@unique([id, departmentId])
}
model TeachingObligation {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  allocationId String
  allocation CourseAllocation @relation(fields: [allocationId, departmentId], references: [id, departmentId], onDelete: Restrict)
  seriesId String
  weekDate String @db.VarChar(10)
  originalDate String @db.VarChar(10)
  requiredMinutes Int
  occurrences ClassOccurrence[]
  @@unique([departmentId, seriesId, weekDate])
  @@unique([id, departmentId])
}
model ClassOccurrence {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  entryId String
  entry TimetableEntry @relation(fields: [entryId, departmentId], references: [id, departmentId], onDelete: Restrict)
  teachingObligationId String
  teachingObligation TeachingObligation @relation(fields: [teachingObligationId, departmentId], references: [id, departmentId], onDelete: Restrict)
  facultyId String
  faculty Faculty @relation(fields: [facultyId, departmentId], references: [id, departmentId], onDelete: Restrict)
  sectionId String
  section Section @relation(fields: [sectionId, departmentId], references: [id, departmentId], onDelete: Restrict)
  roomId String
  room Room @relation(fields: [roomId, departmentId], references: [id, departmentId], onDelete: Restrict)
  localDate String @db.VarChar(10)
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  schedulingStatus SchedulingStatus @default(ACTIVE)
  deliveryStatus DeliveryStatus @default(PENDING)
  // Future leave-resolution publication sets this; template revisions fail closed.
  resolved Boolean @default(false)
  replacesId String? @unique
  replaces ClassOccurrence? @relation("Replacement", fields: [replacesId], references: [id], onDelete: Restrict)
  replacement ClassOccurrence? @relation("Replacement")
  reservations ResourceReservation[]
  leaveRequestId String?
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId, departmentId], references: [id, departmentId], onDelete: Restrict)
  @@unique([entryId, localDate])
  @@unique([id, departmentId])
  @@index([departmentId, startAt, schedulingStatus])
}
model ResourceReservation {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  occurrenceId String
  occurrence ClassOccurrence @relation(fields: [occurrenceId, departmentId], references: [id, departmentId], onDelete: Restrict)
  resourceType ResourceType
  resourceId String
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  @@unique([occurrenceId, resourceType])
}
model MutationReceipt {
  id String @id
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  actorId String
  fingerprint String
  result Json
}
model AuditEvent {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  actorId String
  action String
  entityId String
  before Json
  after Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model Notification {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  recipientId String
  recipient User @relation(fields: [recipientId, departmentId], references: [id, departmentId], onDelete: Restrict)
  changeId String
  message String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  readAt DateTime? @db.Timestamptz(3)
  @@unique([recipientId, changeId])
}

model MasterMutationReceipt {
  id String @id
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  actorId String
  fingerprint String
  recordId String
  @@index([departmentId])
}


enum LeaveStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}
model LeaveRequest {
  id String @id @default(cuid())
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  facultyId String
  faculty Faculty @relation(fields: [facultyId, departmentId], references: [id, departmentId], onDelete: Restrict)
  semesterId String
  semester Semester @relation(fields: [semesterId, departmentId], references: [id, departmentId], onDelete: Restrict)
  startDate String @db.VarChar(10)
  endDate String @db.VarChar(10)
  privateReason String
  status LeaveStatus @default(SUBMITTED)
  version Int @default(1)
  reviewerId String?
  reviewer User? @relation("LeaveReviewer", fields: [reviewerId, departmentId], references: [id, departmentId], onDelete: Restrict)
  rejectionReason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  decidedAt DateTime? @db.Timestamptz(3)
  occurrences ClassOccurrence[]
  @@unique([id, departmentId])
  @@index([departmentId, facultyId, startDate, endDate])
  @@index([departmentId, status, createdAt])
}
