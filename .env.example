# Local demo placeholders only. Change both password values together.
# If using punctuation in a password, URL-encode it in DATABASE_URL.
POSTGRES_USER=slotwise
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=slotwise
DATABASE_URL="postgresql://slotwise:change-me-local-only@127.0.0.1:5433/slotwise?schema=public"

# Generate a unique local secret, e.g. openssl rand -base64 32. Never commit it.
AUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:3000
# Set explicitly for npm run db:seed only; minimum 12 characters. Never use in production.
DEMO_SEED_PASSWORD=
# Dedicated database for integration/browser tests; create it explicitly first.
TEST_DATABASE_URL="postgresql://slotwise:change-me-local-only@127.0.0.1:5433/slotwise_auth_test?schema=public"
