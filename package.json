{
  "name": "slotwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "NEXT_TRACE_SPAN_THRESHOLD_MS=2147483647 next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:check": "node --conditions=react-server --import tsx scripts/check-db.ts",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "db:seed:scenario": "node --conditions=react-server --import tsx prisma/demo-scenario.ts",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "db:test:migrate": "node scripts/migrate-test-db.mjs",
    "worker:emergency": "node --conditions=react-server --import tsx scripts/emergency-worker.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "csv-parse": "7.0.3",
    "dotenv": "^17.2.3",
    "ical-generator": "11.1.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "ical.js": "2.2.1",
    "jsdom": "^29.0.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
